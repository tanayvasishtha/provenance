# replay: run fully offline from the committed snapshot (default). live: fetch from FDA and record new fixtures.
PV_MODE=replay
# Local FalkorDB, or your FalkorDB Cloud host, port, username and password.
PV_FALKORDB_HOST=localhost
PV_FALKORDB_PORT=6379
PV_FALKORDB_USERNAME=
PV_FALKORDB_PASSWORD=
# Used when the FalkorDB above is unreachable at startup. The container sets this to its bundled FalkorDB.
PV_FALKORDB_FALLBACK_HOST=
# Optional. Lets the agent answer live with Claude; every fact still comes from the graph.
PV_ANTHROPIC_API_KEY=
